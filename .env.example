# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://yourdatabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PUBLISHED_KEY
DATABASE_URL="postgresql://postgres:[비밀번호]@db.[참조ID].supabase.co:5432/postgres"

# Service Role Key (Server-side only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 개발/테스트 전용 — 조직(organization_staff) 미소속 계정의 백오피스 접근 우회
# 기본값: 개발 환경(next dev)에서 활성. 0/false/off 로 끌 수 있다.
# 프로덕션 빌드(NODE_ENV=production)에서는 값과 무관하게 항상 비활성이다.
DEV_ALLOW_ORG_BYPASS=1

# 법적 필수 표시 사항 (공통 푸터 / 전자상거래법 제10조)
NEXT_PUBLIC_COMPANY_NAME=(주)미트체인
NEXT_PUBLIC_COMPANY_REPRESENTATIVE=홍길동
NEXT_PUBLIC_COMPANY_BUSINESS_NUMBER=220-88-00000
NEXT_PUBLIC_COMPANY_MAIL_ORDER_NUMBER=제 2026-서울성동-00000호
NEXT_PUBLIC_COMPANY_ADDRESS=서울특별시 성동구 마장로 123 미트타워 5층
NEXT_PUBLIC_PRIVACY_OFFICER=이순신
NEXT_PUBLIC_SUPPORT_EMAIL=support@wholesale-meat.kr
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@wholesale-meat.kr
NEXT_PUBLIC_SUPPORT_PHONE=1588-0000
NEXT_PUBLIC_SUPPORT_HOURS=평일 09:00 ~ 18:00 (토/일/공휴일 휴무)
