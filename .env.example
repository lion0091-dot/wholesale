# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://yourdatabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PUBLISHED_KEY
DATABASE_URL="postgresql://postgres:[비밀번호]@db.[참조ID].supabase.co:5432/postgres"

# Service Role Key (Server-side only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 플랫폼 슈퍼관리자 부트스트랩.
# 이 이메일로 카카오 로그인하면 /auth/callback 에서 profiles.role 이 'super_admin' 으로
# 자동 승격된다(최초 1회). 승격 이후 모든 권한 판정은 DB 값만 사용하므로,
# 이 변수를 지워도 이미 승격된 관리자 계정은 유지된다(=권한 회수는 DB에서 한다).
#
# · NEXT_PUBLIC_ 접두사가 없으므로 브라우저 번들에 포함되지 않는다.
# · 승격에는 SUPABASE_SERVICE_ROLE_KEY 가 필요하다 (승격 RPC 는 service_role 전용).
# · 카카오 계정이 이메일 제공에 동의하지 않으면 승격되지 않는다.
SUPER_ADMIN_EMAIL=admin@yourdomain.kr

# 카카오 로그인(공급사 + 바이어 공용) OAuth 복귀 주소.
# 미설정 시 요청 헤더(x-forwarded-host)에서 유추하지만, 프록시 환경에서는 반드시 지정한다.
# 이 값 + /auth/callback 을 Supabase 대시보드 > Authentication > URL Configuration >
# Redirect URLs 에 등록해야 카카오 로그인이 완료된다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 개발/테스트 전용 — 조직(organization_staff) 미소속 계정의 백오피스 접근 우회
# 기본값: 개발 환경(next dev)에서 활성. 0/false/off 로 끌 수 있다.
# 프로덕션 빌드(NODE_ENV=production)에서는 값과 무관하게 항상 비활성이다.
DEV_ALLOW_ORG_BYPASS=1

# 모든 화면 상단에 "테스트 환경입니다" 배너를 띄울지 여부.
# 값이 없거나 true가 아니면 배너가 항상 노출된다(안전한 기본값).
# 실제 서비스 오픈 시에만 명시적으로 true로 설정해 배너를 끈다.
NEXT_PUBLIC_IS_LIVE=false

# 법적 필수 표시 사항 (공통 푸터 / 전자상거래법 제10조)
NEXT_PUBLIC_COMPANY_NAME=(주)미트체인
NEXT_PUBLIC_COMPANY_REPRESENTATIVE=홍길동
NEXT_PUBLIC_COMPANY_BUSINESS_NUMBER=220-88-00000
NEXT_PUBLIC_COMPANY_MAIL_ORDER_NUMBER=제 2026-서울성동-00000호
NEXT_PUBLIC_COMPANY_ADDRESS=서울특별시 성동구 마장로 123 미트타워 5층
NEXT_PUBLIC_PRIVACY_OFFICER=이순신
NEXT_PUBLIC_SUPPORT_EMAIL=support@wholesale-meat.kr
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@wholesale-meat.kr
NEXT_PUBLIC_SUPPORT_PHONE=1588-0000
NEXT_PUBLIC_SUPPORT_HOURS=평일 09:00 ~ 18:00 (토/일/공휴일 휴무)

# 공공데이터포털(data.go.kr) 국세청_사업자등록정보 진위확인 및 상태조회 서비스 — 일반 인증키(Decoding)
NTS_BUSINESS_VERIFY_API_KEY=your-nts-service-key

# 스위트트래커(tracking.sweettracker.co.kr) 배송 조회 API 키 — 운송장 발급/정산 대행 아님, 조회 전용
SWEETTRACKER_API_KEY=your-sweettracker-api-key

# 공공데이터포털(data.go.kr) 축산물품질평가원_축산물등급판정정보 서비스키 — 소/돼지 전국 평균 경락가 참고용 위젯
KAPE_MARKET_PRICE_API_KEY=your-kape-market-price-api-key

# 시세 동기화 크론(vercel.json)이 자기 자신임을 증명하는 값 — Vercel이 크론 호출 시
# Authorization: Bearer <CRON_SECRET> 헤더를 자동으로 붙여준다. 미설정이면 인증 없이 허용
# (읽기 전용 공개 시세를 긁어와 저장만 하는 낮은 위험 엔드포인트라 필수는 아님).
CRON_SECRET=your-random-cron-secret

# 공급사별 제3자 서비스 인증정보(예: 알림톡 대행사 비밀번호)를 DB에 암호화해서 저장할 때 쓰는
# AES-256-GCM 키. 32바이트 hex 문자열(64자)이어야 한다 — openssl rand -hex 32.
# 미설정 시 해당 인증정보 저장/발송 기능은 (평문 저장으로 조용히 넘어가지 않고) 명시적으로 실패한다.
CREDENTIAL_ENCRYPTION_KEY=your-64-char-hex-aes-256-key

# 거래명세서/계산서 PDF의 카카오톡 인앱 브라우저 "외부에서 열기" 서명 토큰 시크릿.
# 인앱 웹뷰 → 시스템 브라우저(Safari 등)로 넘어가면 세션 쿠키가 사라져 로그인 화면으로
# 튕기는 문제를, 짧은 유효시간(10분) 서명 토큰(/doc/[token])으로 우회한다.
# 미설정 시 토큰 발급이 조용히 스킵되고 기존 방식(보호된 라우트 직접 링크)으로 폴백한다 —
# 이 경우 카카오+외부브라우저 조합에서는 다시 로그인해야 할 수 있다.
# 충분히 긴 무작위 문자열 사용 (예: openssl rand -hex 32).
DOCUMENT_LINK_SECRET=your-random-secret-for-document-links

# 팝빌(popbill.com) 파트너 연동 — 계산서(면세) 국세청 실제 발행/정정 대행.
# 알림톡과 달리 공급사별 계약이 아니라 플랫폼-팝빌 파트너 계약 1건이면 된다(공급사는
# 자동 가입됨). POPBILL_IS_TEST는 "false"를 명시해야만 운영 전환(그 외 값은 테스트 모드
# fail-safe). docs/tax-invoice-nts-filing.md 참고 — 계약 전이라 아직 미검증.
POPBILL_LINK_ID=your-popbill-partner-link-id
POPBILL_SECRET_KEY=your-popbill-partner-secret-key
POPBILL_IS_TEST=true
